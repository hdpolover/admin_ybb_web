#--------------------------------------------------------------------
# YBB Admin System Environment Configuration Template
#
# Copy this file to .env and update the values according to your
# environment setup. All sensitive values should be replaced with
# your actual configuration.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = ybb_database
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# EMAIL (Resend)
#--------------------------------------------------------------------

# Generate the API key at https://resend.com/api-keys
# The sending domain (right side of the <…> bracket in RESEND_FROM) must be verified
# in the Resend dashboard, otherwise sends will be rejected with a 403.
RESEND_API_KEY = re_your_api_key_here
RESEND_FROM = "Your Organization <no-reply@notifications.example.com>"

#--------------------------------------------------------------------
# CACHE CONFIGURATION
#--------------------------------------------------------------------

cache.handler = redis
cache.backupHandler = file
cache.prefix = ybb_app_
cache.ttl = 3600

# Redis Configuration
cache.redis.host = 127.0.0.1
cache.redis.port = 6379
cache.redis.password = 
cache.redis.database = 0
cache.redis.prefix = ybb_app_
cache.redis.timeout = 0

#--------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY
#--------------------------------------------------------------------

MIDTRANS_IS_PRODUCTION = false
MIDTRANS_SERVER_KEY = your-production-server-key
MIDTRANS_CLIENT_KEY = your-production-client-key
MIDTRANS_SB_SERVER_KEY = your-sandbox-server-key
MIDTRANS_SB_CLIENT_KEY = your-sandbox-client-key
MIDTRANS_IS_SANITIZED = true
MIDTRANS_IS_3DS = true

#--------------------------------------------------------------------
# XENDIT PAYMENT GATEWAY
#--------------------------------------------------------------------

XENDIT_IS_PRODUCTION = false
XENDIT_SECRET_KEY = xnd_development_YOUR_SECRET_KEY
XENDIT_CALLBACK_TOKEN = YOUR_WEBHOOK_CALLBACK_TOKEN

# Webhook URL to register in Xendit Dashboard:
# https://your-admin-domain.com/api/payment/notification/xendit

#--------------------------------------------------------------------
# GOOGLE OAUTH2 CONFIGURATION
#--------------------------------------------------------------------

GOOGLE_CLIENT_ID = your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = your-google-client-secret
GOOGLE_REDIRECT_URI = https://your-admin-domain.com/auth/google/callback
GOOGLE_PROJECT_ID = your-google-project-id

#--------------------------------------------------------------------
# YBB EXPORT API
#--------------------------------------------------------------------

YBB_EXPORT_API_URL = https://your-export-api-url.com
# For local development:
# YBB_EXPORT_API_URL = http://localhost:5000

#--------------------------------------------------------------------
# OPTIONAL: PRODUCTION SETTINGS
#--------------------------------------------------------------------
# Uncomment these for production deployment

# app.forceGlobalSecureRequests = true
# logger.threshold = 3
# security.csrfProtection = 'cookie'