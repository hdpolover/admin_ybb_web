#--------------------------------------------------------------------
# YBB Admin System Environment Configuration Template
#
# Copy this file to .env and update the values according to your
# environment setup. All sensitive values should be replaced with
# your actual configuration.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = ybb_database
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# EMAIL CONFIGURATION
#--------------------------------------------------------------------

email.fromEmail = noreply@yourdomain.com
email.fromName = "Your Organization Name"
email.protocol = smtp
email.SMTPHost = smtp.gmail.com
email.SMTPUser = your-email@gmail.com
email.SMTPPass = your-app-password
email.SMTPPort = 587
email.SMTPTimeout = 60
email.SMTPCrypto = tls
email.mailType = html
email.charset = UTF-8

#--------------------------------------------------------------------
# CACHE CONFIGURATION
#--------------------------------------------------------------------

cache.handler = redis
cache.backupHandler = file
cache.prefix = ybb_app_
cache.ttl = 3600

# Redis Configuration
cache.redis.host = 127.0.0.1
cache.redis.port = 6379
cache.redis.password = 
cache.redis.database = 0
cache.redis.prefix = ybb_app_
cache.redis.timeout = 0

#--------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY
#--------------------------------------------------------------------

MIDTRANS_IS_PRODUCTION = false
MIDTRANS_SERVER_KEY = your-production-server-key
MIDTRANS_CLIENT_KEY = your-production-client-key
MIDTRANS_SB_SERVER_KEY = your-sandbox-server-key
MIDTRANS_SB_CLIENT_KEY = your-sandbox-client-key
MIDTRANS_IS_SANITIZED = true
MIDTRANS_IS_3DS = true

#--------------------------------------------------------------------
# YBB EXPORT API
#--------------------------------------------------------------------

YBB_EXPORT_API_URL = https://your-export-api-url.com
# For local development:
# YBB_EXPORT_API_URL = http://localhost:5000

#--------------------------------------------------------------------
# OPTIONAL: PRODUCTION SETTINGS
#--------------------------------------------------------------------
# Uncomment these for production deployment

# app.forceGlobalSecureRequests = true
# logger.threshold = 3
# security.csrfProtection = 'cookie'