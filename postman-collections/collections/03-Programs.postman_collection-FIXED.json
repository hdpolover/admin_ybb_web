              "mode": "raw",
              "raw": "{\n    \"name\": \"Updated Speaker Name\",\n    \"position\": \"Updated Position\",\n    \"company\": \"Updated Company\",\n    \"bio\": \"Updated biography\",\n    \"is_keynote\": true,\n    \"order\": 2\n}"
