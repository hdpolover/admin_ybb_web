  "item": [
    {
      "name": "Programs",
      "item": [
        {
          "name": "Get All Programs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/programs",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "programs"
              ]
            },
            "description": "Get all programs"
          }
        },
        {
          "name": "Get Program by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/programs/{{program_id}}",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "programs",
                "{{program_id}}"
              ]
            },
            "description": "Get single program by ID"
          }
        }
      ]
    },
