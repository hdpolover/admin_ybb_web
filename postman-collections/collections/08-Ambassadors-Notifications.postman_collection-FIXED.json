{
  "info": {
    "name": "YBB API - Ambassadors & Notifications - FIXED",
    "description": "Fixed collection with only verified endpoints. Original had validation issues, now contains only working endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ambassadors",
      "item": [
        {
          "name": "Get All Ambassadors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/ambassadors?page=1&limit=10",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "ambassadors"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get all ambassadors for current program"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  }
}